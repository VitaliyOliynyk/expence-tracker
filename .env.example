# ---------------------------------------------------------------------------
# Skopiuj do .env:  cp .env.example .env
# Plik .env jest wspoldzielony przez oba workspace'y (frontend, backend, db).
# ---------------------------------------------------------------------------

# --- Baza danych (docker-compose.yml) --------------------------------------
POSTGRES_PORT=5432
DATABASE_URL="postgresql://expence:expence@localhost:5432/expence_tracker?schema=public"

# --- Auth.js ---------------------------------------------------------------
# MUSI byc identyczny w frontendzie i backendzie - backend weryfikuje nim JWT.
# Wygeneruj:  openssl rand -base64 32
AUTH_SECRET="zmien-mnie-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Wylacz w produkcji za reverse proxy dopiero po ustawieniu AUTH_TRUST_HOST
AUTH_TRUST_HOST=true

# --- Adresy aplikacji ------------------------------------------------------
# Frontend -> backend (widoczne w przegladarce, stad prefiks NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Backend -> lista dozwolonych originow CORS
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
